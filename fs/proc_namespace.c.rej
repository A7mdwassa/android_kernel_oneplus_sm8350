 #endif
 
 	seq_printf(m, "%i %i %u:%u ", r->mnt_id, r->mnt_parent->mnt_id,
@@ -220,8 +226,9 @@ static int show_vfsstat(struct seq_file *m, struct vfsmount *mnt)
